#!/bin/bash

set -ex

CONFIG_FILE="${NET_CONF:-/net/net.conf}"

if [ ! -f "$CONFIG_FILE" ]; then
    echo "config $CONFIG_FILE does not exist"
    exit 1
fi

. "$CONFIG_FILE"

CONNECTIONS_PATH="$NET_HOME/$CONNECTIONS"

test_root() {
    if [ "$EUID" != 0 ]; then
        exit 1
    fi

    return 0
}

test_interface() {
    ip link show "$1" > /dev/null || return 1

    return 0
}

test_ip() {
    local ip
    ip=$(ip -4 -br addr show dev "$1" | awk '{print $3}')

    if [ -z "$ip" ]; then
        return 1
    fi

    return 0
}

test_connect() {
    ping -c 1 -W 1 "$TEST_IP" &> /dev/null || return 1

    return 0
}

test_vpn() {

    local try=0
    local ip

    while [ "$try" -lt 3 ] && [ "$ip" != "$VPN_IP" ]
    do
        ip=$(traceroute -w 1 -m 1 "$TEST_IP" | tail -1 | awk '{print $2}')
        try=$((try + 1))
    done

    if [ "$ip" = "$VPN_IP" ]; then
        return 0
    fi

    return 1
}

test_wifi() {

    local try=0
    local ssid

    while [ "$try" -lt 10 ] && [ -z "$ssid" ]
    do
        ssid=$(iw dev "$WIFI_INT" link | grep SSID | awk '{print $2}')
        try=$((try + 1))
        sleep 1
    done

    if [ -z "$ssid" ] || [ "$ssid" != "$1" ]; then
        return 1
    fi

    return 0
}

wire_disconnect() {
    dhclient -r "$1" > /dev/null
}

wifi_disconnect() {
    pkill -f "wpa_supplicant.*$1"

    dhclient -r "$1" > /dev/null
}

mac_change() {
    ip link set "$1" down

    macchanger -r "$1" > /dev/null

    ip link set "$1" up
}

sanitize_ssid() {
    printf '%s' "$1" | tr -c 'A-Za-z0-9 _-' '_'
}

case $1 in
    "wire")

        if ! test_root; then
            echo "run as root"
            exit 1
        fi

        if ! test_interface "$WIRE_INT"; then
            echo "interface $WIRE_INT does not exist"
            exit 1
        fi

        case $2 in
            "c")
                if test_ip "$WIRE_INT"; then
                    echo "wire connect on $WIRE_INT"
                    exit 0
                fi

                echo "wire connect on $WIRE_INT"

                if [ "$USE_MACCHANGER" != 0 ]; then
                    mac_change "$WIRE_INT"
                fi

                dhclient "$WIRE_INT"

                if ! test_ip "$WIRE_INT"; then
                    echo "does not set ip"
                    exit 1
                fi

                ;;
            
            "d")
            
                echo "wire disconnect on $WIRE_INT"

                wire_disconnect "$WIRE_INT"

                echo "wire disconnect done"

                ;;
            
            *)
            
                echo "only c, d commands"

                ;;
        esac
        ;;

    "wifi")
        if ! test_root; then
            echo "run as root"
            exit 1
        fi

        if ! test_interface "$WIFI_INT"; then
            echo "interface $WIFI_INT does not exist"
            exit 1
        fi

        case $2 in
            "c")

                if test_ip "$WIFI_INT"; then
                    echo "wifi connect on $WIFI_INT"
                    exit 0
                fi

                if [ "$#" -ne 3 ]; then
                    con="$WIFI_CON"
                else
                    con="$3"
                fi

                safe=$(sanitize_ssid "$con")

                echo "wifi connect $con on $WIFI_INT"

                config="$CONNECTIONS_PATH/${safe}.conf"

                if [ ! -f "$config" ]; then
                    echo "config $config does not exist"
                    exit 1
                fi

                if [ "$USE_MACCHANGER" != 0 ]; then
                    mac_change "$WIFI_INT"
                fi

                wpa_supplicant -B -i "$WIFI_INT" -c "$config" > /dev/null

                if ! test_wifi "$con"; then
                    echo "does not set connection to $con"
                    exit 1
                fi

                dhclient "$WIFI_INT"

                if ! test_ip "$WIFI_INT"; then
                    echo "does not set ip"
                    exit 1
                fi

                ;;
            
            "d")
                echo "wifi disconnect on $WIFI_INT"

                wifi_disconnect "$WIFI_INT"

                echo "wifi disconnect done"

                ;;

            "w")

                if [ "$#" -ne 4 ]; then
                    echo "net wifi w <ssid> <password>" >&2

                    exit 1
                fi

                safe=$(sanitize_ssid "$3")

                wpa_passphrase "$3" "$4" | grep -v -E '^[[:space:]]*#psk=' > "$CONNECTIONS_PATH/${safe}.conf"
                chmod 600 "$CONNECTIONS_PATH/${safe}.conf"

                ;;

            "l")
                
                echo "wifi list ssid"

                iwlist scan |& awk -F '["]' '/ESSID:/ {print $2}' | sort -u

                ;;
            
            *)
                echo "only c, d, w, l commands"

                ;;
        esac
        ;;

    "status")

        if ! test_connect; then
            echo "n"
            exit 0
        fi

        if ! test_vpn; then
            echo "c"
            exit 0
        fi

        echo "v"

        ;;
    "stats")

        if ! test_connect; then
            echo "-"
            exit 0
        fi

        ping -q -c 10 "$TEST_IP" | awk -F '[ /]' '/loss/ {loss=$6} /rtt/ {avg=$8} END {print loss,avg}'

        ;;
    *)
        echo "only wire, wifi, status, stats"

        ;;
esac
