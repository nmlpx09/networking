set -eu

CONFIG_FILE="${NET_CONF:-/net/net.conf}"

if [ ! -f "$CONFIG_FILE" ]; then
    echo "config $CONFIG_FILE does not exist" >&2
    exit 1
fi

. "$CONFIG_FILE"

CONNECTIONS_PATH="$NET_HOME/$CONNECTIONS"

test_root() {
    [ "$(id -u)" -eq 0 ]
}

test_interface() {
    ip link show "$1" > /dev/null 2>&1
}

test_ip() {
    local ip
    ip=$(ip -4 -br addr show dev "$1" | awk '{print $3}')

    [ -n "$ip" ]
}

test_connect() {
    ping -c 1 -W 1 "$TEST_IP" > /dev/null 2>&1
}

test_vpn() {
    local dev
    dev=$(ip -o route get "$TEST_IP" | awk '{for(i=1; i<=NF; i++) if($i=="dev") print $(i+1); exit}')

    [ "$dev" = "$VPN_INT" ]
}

test_wifi() {
    local try=0
    local ssid=""

    while [ "$try" -lt 10 ] && [ -z "$ssid" ]
    do
        ssid=$(iw dev "$1" link | awk '/SSID:/ {print $2; exit}')
        try=$((try + 1))
        sleep 1
    done

    [ -n "$ssid" ] && [ "$ssid" = "$2" ]
}

wire_disconnect() {
    eval "$VPN_DISCONNECT_COMMAND" > /dev/null 2>&1 || :

    dhclient -r "$1" > /dev/null 2>&1
}

wifi_disconnect() {
    pkill -f "wpa_supplicant.*$1" || :

    eval "$VPN_DISCONNECT_COMMAND" > /dev/null 2>&1 || :

    dhclient -r "$1" > /dev/null 2>&1
}

mac_change() {
    ip link set "$1" down

    macchanger -r "$1" > /dev/null

    ip link set "$1" up
}

sanitize_ssid() {
    printf '%s' "$1" | tr -c 'A-Za-z0-9 _-' '_'
}

case $1 in
    "wire")

        if ! test_root; then
            echo "run as root" >&2
            exit 1
        fi

        if ! test_interface "$WIRE_INT"; then
            echo "interface $WIRE_INT does not exist" >&2
            exit 1
        fi

        case $2 in
            "c")
                if test_ip "$WIRE_INT"; then
                    echo "wire already connect on $WIRE_INT"
                    exit 0
                fi

                echo "wire connect on $WIRE_INT"

                ip link set "$WIRE_INT" up

                if [ "$USE_MACCHANGER" != 0 ]; then
                    mac_change "$WIRE_INT"
                fi

                dhclient "$WIRE_INT"

                if ! test_ip "$WIRE_INT"; then
                    echo "does not set ip" >&2
                    exit 1
                fi

                echo "wire connect done"

                ;;

            "d")

                echo "wire disconnect on $WIRE_INT"

                wire_disconnect "$WIRE_INT"

                echo "wire disconnect done"

                ;;

            *)

                echo "only c, d commands"

                exit 2

                ;;
        esac
        ;;

    "wifi")
        if ! test_root; then
            echo "run as root" >&2
            exit 1
        fi

        if ! test_interface "$WIFI_INT"; then
            echo "interface $WIFI_INT does not exist" >&2
            exit 1
        fi

        case $2 in
            "c")

                if test_ip "$WIFI_INT"; then
                    echo "wifi already connect on $WIFI_INT"
                    exit 0
                fi

                if [ "$#" -ne 3 ]; then
                    con="$WIFI_CON"
                else
                    con="$3"
                fi

                safe=$(sanitize_ssid "$con")

                echo "wifi connect $con on $WIFI_INT"

                config="$CONNECTIONS_PATH/${safe}.conf"

                if [ ! -f "$config" ]; then
                    echo "config $config does not exist" >&2
                    exit 1
                fi

                ip link set "$WIFI_INT" up

                if [ "$USE_MACCHANGER" != 0 ]; then
                    mac_change "$WIFI_INT"
                fi

                wpa_supplicant -B -i "$WIFI_INT" -c "$config" > /dev/null

                if ! test_wifi "$WIFI_INT" "$con"; then
                    echo "does not set connection to $con" >&2
                    exit 1
                fi

                dhclient "$WIFI_INT"

                if ! test_ip "$WIFI_INT"; then
                    echo "does not set ip" >&2
                    exit 1
                fi

                echo "wifi connect done"

                ;;

            "d")
                echo "wifi disconnect on $WIFI_INT"

                wifi_disconnect "$WIFI_INT"

                echo "wifi disconnect done"

                ;;

            "w")

                if [ "$#" -ne 4 ]; then
                    echo "net wifi w <ssid> <password>" >&2

                    exit 1
                fi

                safe=$(sanitize_ssid "$3")

                printf '%s\n' "$4" | wpa_passphrase "$3" | grep -v -E '^[[:space:]]*#psk=' > "$CONNECTIONS_PATH/${safe}.conf"
                chmod 600 "$CONNECTIONS_PATH/${safe}.conf"

                ;;

            "l")

                echo "wifi list ssid"

                iwlist "$WIFI_INT" scan 2> /dev/null | awk -F '"' '/ESSID:"[^"]+"/ {print $2}' | sort -u

                ;;

            *)
                echo "only c, d, w, l commands"

                exit 2

                ;;
        esac
        ;;

    "status")

        if ! test_connect; then
            echo "n"
            exit 0
        fi

        if ! test_vpn; then
            echo "c"
            exit 0
        fi

        echo "v"

        ;;

    "stats")

        if ! test_connect; then
            echo "-"
            exit 0
        fi

        ping -q -c 10 "$TEST_IP" | awk -F '[ /]' '/loss/ {loss=$6} /rtt/ {avg=$8} END {print loss,avg}'

        ;;

    "vpn")

        if ! test_root; then
            echo "run as root" >&2
            exit 1
        fi

        case $2 in
            "c")
                if test_vpn; then
                    echo "vpn already connect"
                    exit 0
                fi

                echo "vpn connect"

                eval "$VPN_CONNECT_COMMAND"

                if ! test_vpn; then
                    echo "does not connect vpn" >&2
                    eval "$VPN_DISCONNECT_COMMAND"
                    exit 1
                fi

                echo "vpn connect done"

                ;;

            "d")
                echo "vpn disconnect"

                eval "$VPN_DISCONNECT_COMMAND"

                echo "vpn disconnect done"

                ;;

            *)

                echo "only c, d commands"

                exit 2

                ;;

        esac

        ;;

    *)
        echo "only wire, wifi, status, stats, vpn"

        exit 2

        ;;
esac
