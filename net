#!/bin/bash

set -ex

HOME=/net
WIRE_INT=enp2s0
WIFI_INT=wlo1
WIFI_CON=hidden2
CONNECTIONS=connections
CONNECTIONS_PATH=$HOME/$CONNECTIONS
TEST_IP=1.1.1.1
VPN_IP=10.0.3.1
USE_MACCHANGER=0

if [ $(whoami) != root  ]; then
    echo "run on sudo"

    exit 1
fi

test_interface() {
    ip link show $1 > /dev/null || return 1

    return 0
}

test_ip() {
    ip=$(ip -4 -br addr show dev "$1" | awk '{print $3}')

    if [ -z "$ip" ]; then
        return 1
    fi

    return 0
}

test_connect() {
    traceroute -w 1 -m 1 $TEST_IP > /dev/null || return 1

    return 0
}

test_vpn() {

    try=0

    while [ $try -lt 3 ] && [[ "$ip" != $VPN_IP ]]
    do
        ip=$(traceroute -w 1 -m 1 $TEST_IP | tail -1 | awk '{print $2}')
        ((try++))
    done

    if [[ $ip == "$VPN_IP" ]]; then
        return 0
    fi

    return 1
}

test_wifi() {

    try=0

    while [ $try -lt 10 ] && [ -z "$ssid" ]
    do
        ssid=$(iw dev $WIFI_INT link | grep SSID | awk '{print $2}')
        ((try++))
        sleep 1
    done

    if [ -z "$ssid" ] || [ "$ssid" != "$1" ]; then
        return 1
    fi

    return 0
}

wire_disconnect() {
    dhclient -r "$1" > /dev/null
}

wifi_disconnect() {
    pkill -f "wpa_supplicant.*$1"

    dhclient -r "$1" > /dev/null
}

mac_change() {
    [ "$USE_MACCHANGER" != 1 ] && return 0

    ip link set $1 down

    macchanger -r $1 > /dev/null

    ip link set $1 up
}

case $1 in
    "wire")

        if ! test_interface $WIRE_INT; then
            echo "interface $WIRE_INT does not exist"
            exit 1
        fi

        case $2 in
            "c")
                
                test_ip $WIRE_INT && echo "wire connect on $WIRE_INT" && exit 0

                echo "wire connect on $WIRE_INT"

                mac_change $WIRE_INT

                dhclient $WIRE_INT

                ! test_ip $WIRE_INT && echo "does not set ip" && exit 1
                ;;
            
            "d")
            
                echo "wire disconnect on $WIRE_INT"

                wire_disconnect "$WIRE_INT"

                echo "wire disconnect done"

                ;;
            
            *)
            
                echo "only c, d command"

                ;;
        esac
        ;;

    "wifi")

        if ! test_interface $WIFI_INT; then
            echo "interface $WIFI_INT does not exist"
            exit 1
        fi

        case $2 in
            "c")

                test_ip $WIFI_INT && echo "wifi connect on $WIFI_INT" && exit 0

                if [ "$#" -ne 3 ]; then
                    con=$WIFI_CON
                else
                    con=$3
                fi

                echo "wifi connect $con on $WIFI_INT"

                config=$CONNECTIONS_PATH/${con}.conf

                if [ ! -f "$config" ]; then
                    echo "config $config does not exist"
                    exit 1
                fi
            
                mac_change $WIFI_INT

                wpa_supplicant -B -i $WIFI_INT -c "$config" > /dev/null

                ! test_wifi $con && echo "does not set connection to $con" && exit 1

                dhclient $WIFI_INT

                ! test_ip $WIFI_INT && echo "does not set ip" && exit 1

                ;;
            
            "d")
                echo "wifi disconnect on $WIFI_INT"

                wifi_disconnect "$WIFI_INT"

                echo "wifi disconnect done"

                ;;

            "w")

                if [ "$#" -ne 4 ]; then
                    echo "net w sid pwd"

                    exit 1
                fi

                wpa_passphrase $3 $4 > $CONNECTIONS_PATH/${3}.conf

                ;;

            "l")
                
                echo "wifi list ssid"

                iwlist scan |& grep -oP '(?<=ESSID:)[^\n]+' | tr -d '"' | sort -r

                ;;
            
            *)
                echo "only c, d, w, l command"

                ;;
        esac
        ;;

    "status")
        
        ! test_connect && echo "n" && exit 0

        ! test_vpn && echo "c" && exit 0

        echo "v"

        ;;
    "stats")

        ! test_connect && echo "-" && exit 0
        
        ping -q -c 10 $TEST_IP | awk 'FNR == 4{print $6}FNR == 5{print $4}' | awk 'BEGIN {RS=""}{gsub(/\n|\//," ",$0);print $1,$4}'

        ;;
    *)
        echo "only wire, wif, status, stats"

        ;;
esac
